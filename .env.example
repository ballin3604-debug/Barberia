# ── Supabase ─────────────────────────────────────────────
# Creá un proyecto en https://supabase.com y copiá acá sus valores
# (Dashboard → Project Settings → API)
VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_ANON_KEY="TU_ANON_KEY"

# ── Notificaciones Web Push (opcional) ──────────────────
# Generá las claves con:  npx web-push generate-vapid-keys
# La clave PÚBLICA va acá (en el cliente). La privada va como
# secret de la Edge Function de recordatorios (ver README).
VITE_VAPID_PUBLIC_KEY="TU_CLAVE_PUBLICA_VAPID"
